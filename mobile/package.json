{
  "name": "drink-water-reminder-mobile",
  "version": "1.5.0",
  "description": "喝水提醒 — iOS 手機版（React Native / Expo），原生本地排程通知",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
